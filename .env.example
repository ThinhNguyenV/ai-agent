APP_NAME=AI Media Agent
MEDIA_PROVIDER=diffusers_local
ARTIFACT_DIR=artifacts

# Free local prompt LLM via Ollama
PROMPT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_PROMPT_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=700
OLLAMA_TEMPERATURE=0.45

# Local free/self-hosted models
LOCAL_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Alternatives: Wan-AI/Wan2.1-T2V-1.3B-Diffusers or zai-org/CogVideoX-2b
LOCAL_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
LOCAL_DEVICE=auto
LOCAL_TORCH_DTYPE=auto
LOCAL_ENABLE_CPU_OFFLOAD=true
# LOCAL_SEED=1234
LOCAL_IMAGE_STEPS=30
LOCAL_IMAGE_GUIDANCE_SCALE=7.5
LOCAL_VIDEO_STEPS=30
LOCAL_VIDEO_GUIDANCE_SCALE=5.0
LOCAL_VIDEO_NUM_FRAMES=81
LOCAL_VIDEO_FPS=15

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_VIDEO_MODEL=sora-2

IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
VIDEO_SECONDS=4
VIDEO_SIZE=832x480
VIDEO_POLL_INTERVAL_SECONDS=3
VIDEO_POLL_TIMEOUT_SECONDS=60

DRY_RUN_DELAY_SECONDS=0.2
